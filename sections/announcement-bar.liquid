{%- if section.blocks.size > 0 -%}
  {%- assign promo_duration = section.blocks.size | times: 8 | at_least: 18 -%}
  <div
    class="promo-bar{% if section.blocks.size > 1 %} promo-bar--ticker{% endif %}"
    id="promo-bar"
    style="--promo-duration: {{ promo_duration }}s;"
    role="region"
    aria-label="Store announcements"
  >
    {%- if section.blocks.size == 1 -%}
      <div class="promo-track promo-track--static">
        {%- for block in section.blocks -%}
          {%- if block.type == 'message' -%}
            <span class="promo-msg" {{ block.shopify_attributes }}>
              {{ block.settings.message }}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="promo-marquee">
        {%- for copy in (1..2) -%}
          <div class="promo-track{% if copy == 2 %} promo-track--clone{% endif %}"{% if copy == 2 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- if block.type == 'message' -%}
                <span class="promo-msg"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  {{ block.settings.message }}
                </span>
                <span class="promo-separator" aria-hidden="true"></span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "message",
          "label": "Message text",
          "default": "Free shipping on orders over $150."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        { "type": "message", "settings": { "message": "Free shipping on orders over $150." } },
        { "type": "message", "settings": { "message": "Single donor. Zero chemicals. Pure luxury." } },
        { "type": "message", "settings": { "message": "Lasts 2 to 3 years with proper care." } }
      ]
    }
  ]
}
{% endschema %}
