<section class="bestsellers">
  <div class="section-head">
    <span class="section-label">{{ section.settings.eyebrow }}</span>
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  </div>

  <!-- Filter tabs -->
  <div class="filter-tabs" role="tablist" aria-label="Filter by texture">
    <button type="button" class="ftab active" data-filter="all" role="tab" aria-selected="true">All</button>
    <button type="button" class="ftab" data-filter="straight" role="tab" aria-selected="false">Straight</button>
    <button type="button" class="ftab" data-filter="wavy" role="tab" aria-selected="false">Wavy</button>
    <button type="button" class="ftab" data-filter="curly" role="tab" aria-selected="false">Curly</button>
  </div>

  <!-- Products Grid -->
  <div class="products-grid">
    {%- if section.settings.collection != blank -%}
      {%- assign featured_collection = collections[section.settings.collection] -%}
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback placeholder cards when no collection is set {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="product-card elysian-card" data-texture="straight">
            <div class="elysian-card-media">
              <a href="#" class="elysian-prod-img">
                <span class="elysian-prod-placeholder" aria-hidden="true"></span>
                {%- if i == 1 -%}<span class="prod-badge">Bestseller</span>{%- endif -%}
              </a>
              <a href="#" class="quick-view">Quick View</a>
            </div>
            <div class="prod-info">
              <div class="prod-origin">India</div>
              <div class="prod-name">Product {{ i }}</div>
              <div class="prod-stars">★★★★★</div>
              <div class="prod-price"><span class="from">From</span>$00.00</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Fallback when editor has no collection picked yet {%- endcomment -%}
      {%- for i in (1..4) -%}
        <div class="product-card elysian-card" data-texture="straight">
          <div class="elysian-card-media">
            <a href="#" class="elysian-prod-img">
              <span class="elysian-prod-placeholder" aria-hidden="true"></span>
            </a>
            <a href="#" class="quick-view">Quick View</a>
          </div>
          <div class="prod-info">
            <div class="prod-origin">India</div>
            <div class="prod-name">Sample Product {{ i }}</div>
            <div class="prod-stars">★★★★★</div>
            <div class="prod-price"><span class="from">From</span>$00.00</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.view_all_link != blank -%}
    <div style="text-align:center;margin-top:48px;">
      <a href="{{ section.settings.view_all_link }}" class="btn-outline">{{ section.settings.view_all_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "div",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Customer Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestselling Bundles"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All button link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All button label",
      "default": "View Full Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
