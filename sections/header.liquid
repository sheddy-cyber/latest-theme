<header>
  <div class="nav-wrap" id="nav-wrap">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="nav-logo">
      {{ section.settings.logo_first_word }} <span>{{ section.settings.logo_second_word }}</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="nav-links">

      <!-- Shop (mega menu) -->
      <li>
        <button class="nav-item-btn" id="ni-shop" onclick="tog('shop')" aria-haspopup="true" aria-expanded="false">
          Shop <span class="arr">▾</span>
        </button>

        <div class="mega" id="menu-shop" role="region" aria-label="Shop menu">

          <!-- By Origin column -->
          <div class="mega-col">
            <h4>By Origin</h4>
            <ul class="mega-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'origin_link' -%}
                  {%- liquid
                    assign link_url = block.settings.link
                    if link_url == blank
                      assign link_title_down = block.settings.title | downcase
                      if link_title_down contains 'indian'
                        assign link_url = '/collections/indian-hair'
                        if collections['indian'].products.size > 0
                          assign link_url = '/collections/indian'
                        endif
                      elsif link_title_down contains 'vietnamese'
                        assign link_url = '/collections/vietnamese-hair'
                        if collections['vietnamese'].products.size > 0
                          assign link_url = '/collections/vietnamese'
                        endif
                      elsif link_title_down contains 'cambodian'
                        assign link_url = '/collections/cambodian-hair'
                        if collections['cambodian'].products.size > 0
                          assign link_url = '/collections/cambodian'
                        endif
                      elsif link_title_down contains 'burmese'
                        assign link_url = '/collections/burmese-hair'
                        if collections['burmese'].products.size > 0
                          assign link_url = '/collections/burmese'
                        endif
                      else
                        assign link_url = routes.all_products_collection_url
                      endif
                    endif
                  -%}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ link_url }}">
                      <span class="m-dot" style="background:{{ block.settings.dot_color }};"></span>
                      <span class="mega-item-body">
                        <span class="mega-item-title">{{ block.settings.title }}</span>
                        {%- if block.settings.subtitle != blank -%}
                          <span class="mega-item-sub">{{ block.settings.subtitle }}</span>
                        {%- endif -%}
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
              <li class="mega-viewall">
                <a href="{{ section.settings.shop_all_link }}">
                  <span class="m-dot m-dot-all"></span>
                  <span class="mega-item-body">
                    <span class="mega-item-title">View All Raw Hair</span>
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <!-- By Texture + Quick Finds column -->
          <div class="mega-col">
            <h4>By Texture</h4>
            <ul class="mega-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'texture_link' -%}
                  {%- liquid
                    assign link_url = block.settings.link
                    if link_url == blank
                      assign link_title_down = block.settings.title | downcase
                      if link_title_down contains 'straight'
                        assign link_url = '/collections/straight'
                      elsif link_title_down contains 'wavy'
                        assign link_url = '/collections/wavy'
                      elsif link_title_down contains 'curly'
                        assign link_url = '/collections/curly'
                      else
                        assign link_url = routes.all_products_collection_url
                      endif
                    endif
                  -%}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ link_url }}">
                      <span class="m-dot" style="background:{{ block.settings.dot_color }};"></span>
                      <span class="mega-item-body">
                        <span class="mega-item-title">{{ block.settings.title }}</span>
                        {%- if block.settings.subtitle != blank -%}
                          <span class="mega-item-sub">{{ block.settings.subtitle }}</span>
                        {%- endif -%}
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            <h4 class="sub-head">Quick Finds</h4>
            <ul class="mega-quick">
              <li>
                <a href="{{ section.settings.bestsellers_link }}">
                  <span class="m-dot m-dot-gold"></span>
                  Best Sellers
                </a>
              </li>
              {%- if section.settings.sale_link != blank -%}
                <li>
                  <a href="{{ section.settings.sale_link }}">
                    <span class="m-dot m-dot-sale"></span>
                    On Sale <span class="sale-badge">Sale</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>

          <!-- Shop by Look column -->
          <div class="mega-look">
            <h4>Shop by Look</h4>
            <div class="look-grid">
              {%- for block in section.blocks -%}
                {%- if block.type == 'look_tile' -%}
                  {%- liquid
                    assign link_url = block.settings.link
                    if link_url == blank
                      assign link_label_down = block.settings.label | downcase
                      if link_label_down contains 'sleek'
                        assign link_url = '/collections/straight'
                      elsif link_label_down contains 'volum'
                        assign link_url = '/collections/curly'
                      elsif link_label_down contains 'natural'
                        assign link_url = '/collections/wavy'
                      elsif link_label_down contains 'textured'
                        assign link_url = '/collections/curly'
                      else
                        assign link_url = routes.all_products_collection_url
                      endif
                    endif
                  -%}
                  <a href="{{ link_url }}" class="look-tile" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      <div class="look-tile-img" style="background-image: url('{{ block.settings.image | img_url: '400x400' }}');"></div>
                    {%- else -%}
                      <div class="look-tile-img {{ block.settings.gradient_class }}"></div>
                    {%- endif -%}
                    <div class="look-tile-label">{{ block.settings.label }}</div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

        </div>
      </li>

      <!-- Textures dropdown -->
      {%- if section.settings.textures_menu != blank -%}
        {%- assign textures_linklist = linklists[section.settings.textures_menu] -%}
      {%- endif -%}
      <li style="position:relative;">
        <button class="nav-item-btn" id="ni-tex" onclick="tog('tex')" aria-haspopup="true">
          Textures <span class="arr">▾</span>
        </button>
        <div class="sdrop" id="menu-tex">
          {%- if textures_linklist.links.size > 0 -%}
            {%- for link in textures_linklist.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="/collections/straight">Straight</a>
            <a href="/collections/wavy">Wavy</a>
            <a href="/collections/curly">Curly</a>
            <a href="/collections/deep-curly">Deep Curly</a>
            <a href="/collections/body-wave">Body Wave</a>
            <a href="/collections/all">View All →</a>
          {%- endif -%}
        </div>
      </li>

      <!-- Hair Care dropdown -->
      {%- if section.settings.haircare_menu != blank -%}
        {%- assign haircare_linklist = linklists[section.settings.haircare_menu] -%}
      {%- endif -%}
      <li style="position:relative;">
        <button class="nav-item-btn" id="ni-care" onclick="tog('care')" aria-haspopup="true">
          Hair Care <span class="arr">▾</span>
        </button>
        <div class="sdrop" id="menu-care">
          {%- if haircare_linklist.links.size > 0 -%}
            {%- for link in haircare_linklist.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="/pages/care-guide">Care Guide</a>
            <a href="/pages/washing-tips">Washing Tips</a>
            <a href="/pages/styling-guide">Styling Guide</a>
            <a href="/pages/moisturizing">Moisturizing</a>
            <a href="/pages/faq">FAQs</a>
            <a href="/blogs/news">Blog →</a>
          {%- endif -%}
        </div>
      </li>

      <li><a href="{{ section.settings.about_link | default: '/pages/about' }}">About</a></li>
      <li><a href="{{ section.settings.quiz_link | default: '/pages/hair-quiz' }}">Quiz</a></li>

    </ul>

    <!-- Icons -->
    <div class="nav-icons">
      <a href="{{ routes.cart_url }}" class="cart-link cart-icon" aria-label="Cart">
        Cart <span class="cart-ct">{{ cart.item_count }}</span>
      </a>
      <button class="ham-btn" id="ham-btn" aria-label="Open menu" onclick="toggleMobNav()">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Nav Overlay -->
<div class="mob-nav-overlay" id="mob-overlay" onclick="toggleMobNav()"></div>

<!-- Mobile Nav Drawer -->
<nav class="mob-nav" id="mob-nav" aria-label="Mobile navigation">
  <button class="mob-nav-close" onclick="toggleMobNav()" aria-label="Close menu">✕</button>

  <div class="mob-nav-section">
    <button class="mob-nav-toggle" onclick="toggleMobSub('ms-shop')">Shop <span class="arr">▾</span></button>
    <div class="mob-nav-sub" id="ms-shop">
      {%- for block in section.blocks -%}
        {%- if block.type == 'origin_link' -%}
          {%- liquid
            assign link_url = block.settings.link
            if link_url == blank
              assign link_title_down = block.settings.title | downcase
              if link_title_down contains 'indian'
                assign link_url = '/collections/indian-hair'
                if collections['indian'].products.size > 0
                  assign link_url = '/collections/indian'
                endif
              elsif link_title_down contains 'vietnamese'
                assign link_url = '/collections/vietnamese-hair'
                if collections['vietnamese'].products.size > 0
                  assign link_url = '/collections/vietnamese'
                endif
              elsif link_title_down contains 'cambodian'
                assign link_url = '/collections/cambodian-hair'
                if collections['cambodian'].products.size > 0
                  assign link_url = '/collections/cambodian'
                endif
              elsif link_title_down contains 'burmese'
                assign link_url = '/collections/burmese-hair'
                if collections['burmese'].products.size > 0
                  assign link_url = '/collections/burmese'
                endif
              else
                assign link_url = routes.all_products_collection_url
              endif
            endif
          -%}
          <a href="{{ link_url }}">{{ block.settings.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ section.settings.shop_all_link }}">View All Collections</a>
    </div>
  </div>

  <div class="mob-nav-section">
    <button class="mob-nav-toggle" onclick="toggleMobSub('ms-tex')">Textures <span class="arr">▾</span></button>
    <div class="mob-nav-sub" id="ms-tex">
      {%- if textures_linklist.links.size > 0 -%}
        {%- for link in textures_linklist.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/collections/straight">Straight</a>
        <a href="/collections/wavy">Wavy</a>
        <a href="/collections/curly">Curly</a>
        <a href="/collections/deep-curly">Deep Curly</a>
        <a href="/collections/body-wave">Body Wave</a>
      {%- endif -%}
    </div>
  </div>

  <div class="mob-nav-section">
    <button class="mob-nav-toggle" onclick="toggleMobSub('ms-care')">Hair Care <span class="arr">▾</span></button>
    <div class="mob-nav-sub" id="ms-care">
      {%- if haircare_linklist.links.size > 0 -%}
        {%- for link in haircare_linklist.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="/pages/care-guide">Care Guide</a>
        <a href="/pages/washing-tips">Washing Tips</a>
        <a href="/pages/styling-guide">Styling Guide</a>
        <a href="/pages/faq">FAQs</a>
        <a href="/blogs/news">Blog</a>
      {%- endif -%}
    </div>
  </div>

  <a href="{{ section.settings.about_link | default: '/pages/about' }}" class="mob-nav-link">About</a>
  <a href="{{ section.settings.quiz_link | default: '/pages/hair-quiz' }}" class="mob-nav-link">Hair Quiz</a>

  <div class="mob-nav-footer">
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.account_url }}">Account</a>
  </div>
</nav>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "logo_first_word",
      "label": "Logo — first word",
      "default": "Elysian"
    },
    {
      "type": "text",
      "id": "logo_second_word",
      "label": "Logo — second word (italic)",
      "default": "Imports"
    },
    {
      "type": "header",
      "content": "Mega menu settings"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "View All Raw Hair link"
    },
    {
      "type": "url",
      "id": "bestsellers_link",
      "label": "Best Sellers link"
    },
    {
      "type": "url",
      "id": "sale_link",
      "label": "Sale link (leave blank to hide)"
    },
    {
      "type": "header",
      "content": "Dropdown menus"
    },
    {
      "type": "link_list",
      "id": "textures_menu",
      "label": "Textures dropdown menu",
      "info": "Create a navigation menu named 'textures-menu' in Shopify admin"
    },
    {
      "type": "link_list",
      "id": "haircare_menu",
      "label": "Hair Care dropdown menu",
      "info": "Create a navigation menu named 'haircare-menu' in Shopify admin"
    },
    {
      "type": "header",
      "content": "Extra nav links"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About page link"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Hair Quiz link"
    }
  ],
  "blocks": [
    {
      "type": "origin_link",
      "name": "Shop by Origin item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Indian Hair"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)",
          "default": "Straight · Curly"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "dot_color",
          "label": "Origin dot color",
          "default": "#d4aa5a"
        }
      ]
    },
    {
      "type": "texture_link",
      "name": "Shop by Texture item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Straight"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)",
          "default": "Indian · Vietnamese"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "dot_color",
          "label": "Dot color",
          "default": "#d4aa5a"
        }
      ]
    },
    {
      "type": "look_tile",
      "name": "Shop by Look tile",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Sleek"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional — uses gradient if blank)"
        },
        {
          "type": "select",
          "id": "gradient_class",
          "label": "Gradient style (fallback)",
          "options": [
            { "value": "lt-sleek",    "label": "Sleek" },
            { "value": "lt-volum",    "label": "Voluminous" },
            { "value": "lt-natural",  "label": "Natural" },
            { "value": "lt-textured", "label": "Textured" }
          ],
          "default": "lt-sleek"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "origin_link",  "settings": { "title": "Indian Hair",      "subtitle": "Straight · Curly", "dot_color": "#d4aa5a" } },
        { "type": "origin_link",  "settings": { "title": "Vietnamese Hair",  "subtitle": "Straight",         "dot_color": "#a8843a" } },
        { "type": "origin_link",  "settings": { "title": "Cambodian Hair",   "subtitle": "Wavy",             "dot_color": "#7a5e28" } },
        { "type": "origin_link",  "settings": { "title": "Burmese Hair",     "subtitle": "Curly",            "dot_color": "#2f2921" } },
        { "type": "texture_link", "settings": { "title": "Straight",         "subtitle": "Indian · Vietnamese", "dot_color": "#d4aa5a" } },
        { "type": "texture_link", "settings": { "title": "Wavy",             "subtitle": "Cambodian",           "dot_color": "#7a5e28" } },
        { "type": "texture_link", "settings": { "title": "Curly",            "subtitle": "Indian · Burmese",    "dot_color": "#2f2921" } },
        { "type": "look_tile",    "settings": { "label": "Sleek",       "gradient_class": "lt-sleek"    } },
        { "type": "look_tile",    "settings": { "label": "Voluminous",   "gradient_class": "lt-volum"    } },
        { "type": "look_tile",    "settings": { "label": "Natural",      "gradient_class": "lt-natural"  } },
        { "type": "look_tile",    "settings": { "label": "Textured",     "gradient_class": "lt-textured" } }
      ]
    }
  ]
}
{% endschema %}
