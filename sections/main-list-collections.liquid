{{ 'elysian-pages.css' | asset_url | stylesheet_tag }}

<section class="elysian-collections-landing section">
  <div class="elysian-collections-landing__hero">
    {%- if section.settings.eyebrow != blank -%}
      <span class="elysian-collections-landing__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="elysian-collections-landing__title">{{ section.settings.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="elysian-collections-landing__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}
  </div>

  <div class="elysian-collections-landing__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign featured_collection = block.settings.collection
        assign display_title = block.settings.title | default: featured_collection.title
      -%}
      {%- if featured_collection != blank -%}
        <a href="{{ featured_collection.url }}" class="elysian-collections-landing__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          <div class="elysian-collections-landing__media">
            {%- if featured_collection.featured_image -%}
              <img
                srcset="
                  {%- if featured_collection.featured_image.width >= 165 -%}{{ featured_collection.featured_image | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if featured_collection.featured_image.width >= 330 -%}{{ featured_collection.featured_image | image_url: width: 330 }} 330w,{%- endif -%}
                  {%- if featured_collection.featured_image.width >= 535 -%}{{ featured_collection.featured_image | image_url: width: 535 }} 535w,{%- endif -%}
                  {%- if featured_collection.featured_image.width >= 750 -%}{{ featured_collection.featured_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if featured_collection.featured_image.width >= 1000 -%}{{ featured_collection.featured_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                  {{ featured_collection.featured_image | image_url }} {{ featured_collection.featured_image.width }}w
                "
                src="{{ featured_collection.featured_image | image_url: width: 1200 }}"
                sizes="(min-width: 990px) calc((100vw - 6rem) / 3), (min-width: 750px) calc((100vw - 5rem) / 2), calc(100vw - 3rem)"
                alt="{{ featured_collection.featured_image.alt | default: display_title | escape }}"
                width="{{ featured_collection.featured_image.width }}"
                height="{{ featured_collection.featured_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-apparel-1' | placeholder_svg_tag: 'elysian-collections-landing__placeholder' }}
            {%- endif -%}
          </div>

          <div class="elysian-collections-landing__content">
            <span class="elysian-collections-landing__card-label">Collection</span>
            <h2 class="elysian-collections-landing__card-title">{{ display_title | escape }}</h2>
            {%- if block.settings.description != blank -%}
              <p class="elysian-collections-landing__card-copy">{{ block.settings.description | escape }}</p>
            {%- endif -%}
            <span class="elysian-collections-landing__card-cta">Shop collection</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections landing",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured collections"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Collections"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Browse our core collection groups and jump straight into the textures you want.</p>"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Display title",
          "info": "Optional custom title for the card."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "info": "Optional supporting copy."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections landing",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
