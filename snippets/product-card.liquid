{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign origin_tag = ''
  assign texture_tag = ''
  assign data_tags = product.tags | join: ',' | downcase
  assign show_compare_price = false
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'indian' or tag_lower contains 'burmese' or tag_lower contains 'vietnamese' or tag_lower contains 'cambodian'
      assign origin_tag = tag
    endif
    if tag_lower == 'straight' or tag_lower == 'wavy' or tag_lower == 'curly' or tag_lower == 'deep curly' or tag_lower == 'body wave'
      assign texture_tag = tag_lower
    endif
  endfor

  assign show_badge = false
  assign badge_label = ''
  if product.available == false
    assign show_badge = true
    assign badge_label = 'Sold Out'
  elsif product.tags contains 'Bestseller'
    assign show_badge = true
    assign badge_label = 'Bestseller'
  elsif product.tags contains 'New'
    assign show_badge = true
    assign badge_label = 'New'
  elsif product.compare_at_price > product.price
    assign show_badge = true
    assign badge_label = 'Sale'
  endif
  if product.compare_at_price_min > product.price_min
    assign show_compare_price = true
  endif
-%}

<div class="product-card elysian-card{% unless product.available %} is-sold-out{% endunless %}{% if product.images[1] != blank %} has-secondary-media{% endif %}{% if card_class != blank %} {{ card_class }}{% endif %}" data-texture="{{ texture_tag }}" data-tags="{{ data_tags }}">
  <div class="elysian-card-media">
    <a href="{{ product.url }}" class="elysian-prod-img" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            class: 'elysian-prod-photo',
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
            alt: product.featured_media.alt | default: product.title | escape
        }}
        {%- if product.images[1] != blank -%}
          {{
            product.images[1]
            | image_url: width: 900
            | image_tag:
              class: 'elysian-prod-photo elysian-prod-photo--secondary',
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
              alt: product.images[1].alt | default: product.title | escape
          }}
        {%- endif -%}
      {%- elsif product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 900
          | image_tag:
            class: 'elysian-prod-photo',
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
            alt: product.featured_image.alt | default: product.title | escape
        }}
        {%- if product.images[1] != blank -%}
          {{
            product.images[1]
            | image_url: width: 900
            | image_tag:
              class: 'elysian-prod-photo elysian-prod-photo--secondary',
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
              alt: product.images[1].alt | default: product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        <span class="elysian-prod-placeholder" aria-hidden="true"></span>
      {%- endif -%}

      {%- if show_badge -%}
        <span class="prod-badge">{{ badge_label }}</span>
      {%- endif -%}
    </a>
    <a href="{{ product.url }}" class="quick-view">Quick View</a>
  </div>

  <div class="prod-info">
    {%- if origin_tag != '' -%}
      <div class="prod-origin">{{ origin_tag }}</div>
    {%- endif -%}
    <div class="prod-name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </div>
    <div class="prod-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
    <div class="prod-price">
      {%- if product.price_varies -%}
        <span class="from">From</span>
      {%- endif -%}
      <span class="current-price">{{ product.price_min | money }}</span>
      {%- if show_compare_price -%}
        <span class="compare">{{ product.compare_at_price_min | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>
