{% comment %}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign origin_tag = ''
  assign texture_tag = ''
  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag contains 'India' or tag contains 'Burma' or tag contains 'Vietnam' or tag contains 'Cambodia'
      assign origin_tag = tag
    endif
    if tag_lower == 'straight' or tag_lower == 'wavy' or tag_lower == 'curly' or tag_lower == 'deep curly' or tag_lower == 'body wave'
      assign texture_tag = tag_lower
    endif
  endfor

  assign show_badge = false
  assign badge_label = ''
  if product.tags contains 'Bestseller'
    assign show_badge = true
    assign badge_label = 'Bestseller'
  elsif product.tags contains 'New'
    assign show_badge = true
    assign badge_label = 'New'
  elsif product.compare_at_price > product.price
    assign show_badge = true
    assign badge_label = 'Sale'
  endif
-%}

<div class="product-card elysian-card" data-texture="{{ texture_tag }}">
  <div class="elysian-card-media">
    <a href="{{ product.url }}" class="elysian-prod-img" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            class: 'elysian-prod-photo',
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
            alt: product.featured_media.alt | default: product.title | escape
        }}
      {%- elsif product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 900
          | image_tag:
            class: 'elysian-prod-photo',
            loading: 'lazy',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
            alt: product.featured_image.alt | default: product.title | escape
        }}
      {%- else -%}
        <span class="elysian-prod-placeholder" aria-hidden="true"></span>
      {%- endif -%}

      {%- if show_badge -%}
        <span class="prod-badge">{{ badge_label }}</span>
      {%- endif -%}
    </a>
    <a href="{{ product.url }}" class="quick-view">Quick View</a>
  </div>

  <div class="prod-info">
    {%- if origin_tag != '' -%}
      <div class="prod-origin">{{ origin_tag }}</div>
    {%- endif -%}
    <div class="prod-name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </div>
    <div class="prod-stars" aria-hidden="true">★★★★★</div>
    <div class="prod-price">
      {%- if product.price_varies -%}
        <span class="from">From</span>
      {%- endif -%}
      {{ product.price_min | money }}
    </div>
  </div>
</div>
